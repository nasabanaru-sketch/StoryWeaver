# ==============================================================================
# StoryWeaver Environment Variables Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# Note: Never commit .env to version control!
# ==============================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Ollama LLM Service Configuration
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SEC=30
OLLAMA_WARMUP_TIMEOUT_SEC=120

# ComfyUI Image Generation Engine Configuration
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SEC=500
COMFYUI_INPUT_DIR=C:\path\to\comfyui\input

# Voice Analysis & Audio Models Configuration
# Path to local SenseVoiceSmall model directory or huggingface/modelscope repo ID
SENSEVOICE_MODEL=C:\path\to\SenseVoiceSmall\snapshots\master
QWEN2_AUDIO_MODEL=Qwen/Qwen2-Audio-7B-Instruct

# Workflow & Presets File Paths
WORKFLOW_PATH=storyweaver_anime_nofd_api.json
PRESETS_PATH=presets.json

# Performance & VRAM Tuning
VRAM_STANDBY_MAX_MB=8192
VRAM_PEAK_LIMIT_MB=14848
SESSION_TTL_SEC=900
